<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
  <div class="mb-8 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold mb-2" style="color: #433E3F;">
      코드 진행 생성
    </h1>
    <p class="text-gray-600 text-sm sm:text-base">기분에 맞는 코드 진행을 선택하세요</p>
  </div>

  <div class="bg-white rounded-xl shadow-lg border p-6 mb-8" style="border-color: #D4A37333;">
    <%= form_with url: compositions_path, method: :post, local: false, class: "space-y-6" do |f| %>
      <div>
        <label for="mood" class="block text-sm font-semibold mb-2" style="color: #433E3F;">
          분위기 선택
        </label>
        <select name="mood" id="mood" class="w-full px-4 py-2 rounded-lg border bg-white text-gray-800 border-gray-300 focus:border-D4A373 focus:ring-2 focus:ring-D4A373/20 outline-none transition">
          <option value="기쁨" selected>기쁨</option>
          <option value="슬픔">슬픔</option>
          <option value="몽환">몽환</option>
          <option value="어둠">어둠</option>
          <option value="희망">희망</option>
          <option value="쓸쓸">쓸쓸</option>
          <option value="낭만">낭만</option>
          <option value="평온">평온</option>
        </select>
      </div>

      <div class="flex justify-center">
        <button 
          type="submit" 
          class="px-8 py-3 rounded-lg font-semibold text-lg transition-all transform hover:scale-105 active:scale-95 shadow-lg text-white"
          style="background-color: #D4A373;"
        >
          ⚡ 생성하기
        </button>
      </div>
    <% end %>
  </div>
</div>
