<% content_for :title, "CharlieK" %>

<div class="max-w-7xl mx-auto px-1 sm:px-2 py-1 sm:py-2 w-full overflow-x-hidden">
  <%# 카드 뉴스 섹션 %>
  <% if @stock_posts.any? %>
    <%# 데스크톱: 3개씩 2줄 (그리드) %>
    <div class="hidden md:grid md:grid-cols-3 md:gap-4 md:mb-4">
      <% @stock_posts.each do |post| %>
        <%= link_to post_path(post), class: "block bg-white rounded-lg shadow-md overflow-hidden border transition hover:shadow-lg", style: "border-color: #D4A37333;" do %>
          <%# 이미지 영역 %>
          <div class="w-full h-48 overflow-hidden bg-gray-200">
            <% if post.attachment_file.attached? %>
              <%= image_tag post.attachment_file, alt: post.title, class: "w-full h-full object-cover", loading: "lazy" %>
            <% else %>
              <%# 게시글 내용에서 첫 번째 이미지 찾기 %>
              <% img_match = post.content.to_s.match(/<img[^>]+src=["']([^"']+)["']/i) %>
              <% if img_match && img_match[1].present? %>
                <% img_src = img_match[1] %>
                <% if img_src.start_with?('http://') || img_src.start_with?('https://') %>
                  <img src="<%= img_src %>" alt="<%= post.title %>" class="w-full h-full object-cover" loading="lazy" onerror="this.parentElement.style.backgroundColor='#E5E7EB'; this.style.display='none';">
                <% elsif img_src.start_with?('/') %>
                  <img src="<%= img_src %>" alt="<%= post.title %>" class="w-full h-full object-cover" loading="lazy" onerror="this.parentElement.style.backgroundColor='#E5E7EB'; this.style.display='none';">
                <% end %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-gray-400">
                  <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              <% end %>
            <% end %>
          </div>
          
          <%# 제목 영역 (두 줄 제한) %>
          <div class="p-3">
            <h3 class="text-sm font-semibold text-gray-900 line-clamp-2" style="color: #433E3F; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= post.title %>
            </h3>
          </div>
        <% end %>
      <% end %>
    </div>
    
    <%# 모바일: 세로 스크롤 (카드형) %>
    <div class="md:hidden space-y-4">
      <% @stock_posts.each do |post| %>
        <%= link_to post_path(post), class: "block bg-white rounded-lg shadow-md overflow-hidden border transition", style: "border-color: #D4A37333;" do %>
          <div class="flex">
            <%# 이미지 영역 (모바일: 좌측 작은 이미지) %>
            <div class="w-24 h-24 flex-shrink-0 overflow-hidden bg-gray-200">
              <% if post.attachment_file.attached? %>
                <%= image_tag post.attachment_file, alt: post.title, class: "w-full h-full object-cover", loading: "lazy" %>
              <% else %>
                <% img_match = post.content.to_s.match(/<img[^>]+src=["']([^"']+)["']/i) %>
                <% if img_match && img_match[1].present? %>
                  <% img_src = img_match[1] %>
                  <% if img_src.start_with?('http://') || img_src.start_with?('https://') || img_src.start_with?('/') %>
                    <img src="<%= img_src %>" alt="<%= post.title %>" class="w-full h-full object-cover" loading="lazy" onerror="this.parentElement.style.backgroundColor='#E5E7EB'; this.style.display='none';">
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center text-gray-400">
                      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                    </div>
                  <% end %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center text-gray-400">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                <% end %>
              <% end %>
            </div>
            
            <%# 제목 영역 (모바일: 우측) %>
            <div class="flex-1 p-3">
              <h3 class="text-sm font-semibold text-gray-900 line-clamp-2" style="color: #433E3F; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= post.title %>
              </h3>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-md border p-8 text-center" style="border-color: #D4A37333;">
      <p class="text-gray-500">이미지가 있는 게시글이 없습니다.</p>
    </div>
  <% end %>
  
  <%# 인기글과 최신글 섹션 - 데스크톱: 2열, 모바일: 세로 배치 %>
  <div class="mt-2 sm:mt-3">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
      <%# 인기글 섹션 %>
      <div class="bg-white rounded-lg shadow-md border p-4" style="border-color: #D4A37333;">
        <h2 class="text-xs font-semibold mb-2" style="color: #433E3F;">인기 글</h2>
        <% if @popular_posts&.any? %>
          <ul class="space-y-1.5">
            <% @popular_posts.each do |post| %>
              <li>
                <%= link_to post_path(post), class: "block hover:opacity-80 transition" do %>
                  <div class="flex items-center gap-2 text-sm min-w-0">
                    <span class="font-medium flex-1 truncate" style="color: #433E3F;"><%= post.title %></span>
                    <div class="flex items-center gap-1.5 text-xs text-gray-500 flex-shrink-0">
                      <span><%= post.user&.display_name || "익명" %></span>
                      <span>·</span>
                      <span class="flex items-center gap-0.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        <%= format_number_short(post.views_count || 0) %>
                      </span>
                    </div>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-gray-500">인기 글이 없습니다.</p>
        <% end %>
      </div>
      
      <%# 최신글 섹션 %>
      <div class="bg-white rounded-lg shadow-md border p-4" style="border-color: #D4A37333;">
        <h2 class="text-sm font-semibold mb-2" style="color: #433E3F;">최신 글</h2>
        <% if @recent_posts&.any? %>
          <ul class="space-y-1.5">
            <% @recent_posts.each do |post| %>
              <li>
                <%= link_to post_path(post), class: "block hover:opacity-80 transition" do %>
                  <div class="flex items-center gap-2 text-sm min-w-0">
                    <span class="font-medium flex-1 truncate" style="color: #433E3F;"><%= post.title %></span>
                    <div class="flex items-center gap-1.5 text-xs text-gray-500 flex-shrink-0">
                      <span><%= post.user&.display_name || "익명" %></span>
                      <span>·</span>
                      <span class="flex items-center gap-0.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        <%= format_number_short(post.views_count || 0) %>
                      </span>
                    </div>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-gray-500">최신 글이 없습니다.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
