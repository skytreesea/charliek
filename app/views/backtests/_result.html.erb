<div class="bg-white rounded-xl shadow-md border p-2 sm:p-8 mt-8" style="border-color: #D4A37333;">
  <h2 class="text-lg sm:text-2xl font-bold mb-3 sm:mb-4" style="color: #433E3F;">📊 주식타임머신(WHB) 결과</h2>
  
  <%# 요약 카드 섹션 %>
  <% 
    # 티커 정보 준비
    ticker_names = (tickers || []).map { |t| Stock.display_name(t) }.join(', ')
    start_date_formatted = start_date ? Date.parse(start_date.to_s).strftime('%Y년 %m월 %d일') : ''
    end_date_formatted = end_date ? Date.parse(end_date.to_s).strftime('%Y년 %m월 %d일') : ''
    final_value_formatted = number_to_currency(result[:final_value_usd], unit: "$", precision: 0, delimiter: ",")
    return_percentage = result[:total_return] >= 0 ? "+#{result[:total_return]}" : result[:total_return].to_s
    
    # MDD 발생 날짜 및 최저 가치 계산
    mdd_date = nil
    mdd_value = result[:max_drawdown]
    mdd_portfolio_value = nil
    if result[:portfolio_values] && result[:portfolio_values].any?
      max_value = 0
      max_value_date = nil
      mdd_date = nil
      max_drawdown = 0
      
      result[:portfolio_values].each do |pv|
        value = pv[:portfolio_value_usd]
        if value > max_value
          max_value = value
          max_value_date = pv[:date]
        end
        
        if max_value > 0
          drawdown = ((max_value - value) / max_value * 100).round(2)
          if drawdown > max_drawdown
            max_drawdown = drawdown
            mdd_date = pv[:date]
            mdd_portfolio_value = value
          end
        end
      end
    end
    
    mdd_date_formatted = mdd_date ? mdd_date.strftime('%Y년 %m월 %d일') : end_date_formatted
    mdd_value_formatted = mdd_portfolio_value ? number_to_currency(mdd_portfolio_value, unit: "$", precision: 2, delimiter: ",") : "$0"
    
    summary_text = "#{start_date_formatted}에 #{ticker_names}에 $1,000를 투자했다면, #{end_date_formatted}에는 #{final_value_formatted}(#{return_percentage}%)가 되었습니다. #{mdd_date_formatted}에는 #{mdd_value_formatted}까지 떨어지는 것을 견뎌야 했죠."
  %>
  <div class="mb-4 sm:mb-6 p-2 sm:p-6 rounded-xl border-2 shadow-lg bg-white" style="border-color: #D4A373; background: linear-gradient(to bottom right, #FFFFFF, #FAF9F6);">
    <div class="text-center mb-3 sm:mb-4">
      <p class="text-base sm:text-xl font-semibold leading-relaxed" style="color: #433E3F;">
        <%= summary_text %>
      </p>
    </div>
    
    <% if defined?(share_id) && share_id.present? %>
      <div class="flex flex-col sm:flex-row gap-1.5 sm:gap-3 justify-center items-center mt-2 sm:mt-4">
        <button 
          onclick="copyShareText()" 
          class="px-3 sm:px-5 py-1.5 sm:py-2.5 bg-blue-600 text-white rounded-lg text-xs sm:text-sm font-semibold hover:bg-blue-700 transition shadow-md flex items-center gap-1.5 sm:gap-2"
          id="shareButton"
          style="transform: scale(0.8); transform-origin: center;"
        >
          <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
          </svg>
          텍스트 복사
        </button>
        <a 
          href="<%= backtest_share_path(share_id) %>" 
          target="_blank"
          class="px-3 sm:px-5 py-1.5 sm:py-2.5 bg-green-600 text-white rounded-lg text-xs sm:text-sm font-semibold hover:bg-green-700 transition shadow-md flex items-center gap-1.5 sm:gap-2"
          style="transform: scale(0.8); transform-origin: center;"
        >
          <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
          공유 페이지 열기
        </a>
      </div>
      
      <script>
        function copyShareText() {
          const shareText = `<%= summary_text %>\n\n공유 링크: <%= request.base_url %><%= backtest_share_path(share_id) %>`;
          
          navigator.clipboard.writeText(shareText).then(function() {
            const button = document.getElementById('shareButton');
            const originalText = button.innerHTML;
            button.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 복사 완료!';
            button.classList.remove('bg-blue-600', 'hover:bg-blue-700');
            button.classList.add('bg-green-600', 'hover:bg-green-700');
            
            setTimeout(function() {
              button.innerHTML = originalText;
              button.classList.remove('bg-green-600', 'hover:bg-green-700');
              button.classList.add('bg-blue-600', 'hover:bg-blue-700');
            }, 2000);
          }).catch(function(err) {
            alert('복사에 실패했습니다. 브라우저가 클립보드 접근을 지원하지 않을 수 있습니다.');
          });
        }
      </script>
    <% end %>
  </div>
  
  <%# 초기 자본 정보 %>
  <div class="mb-3 sm:mb-6 p-1.5 sm:p-4 rounded-lg bg-blue-50 border border-blue-200">
    <div class="flex items-center justify-between">
      <span class="text-xs sm:text-sm font-medium text-gray-700">초기 투자 자본:</span>
      <span class="text-sm sm:text-lg font-bold" style="color: #433E3F;">$1,000</span>
    </div>
  </div>

  <%# 주요 지표 %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-1.5 sm:gap-4 mb-4 sm:mb-8">
    <div class="p-2 sm:p-4 rounded-lg border" style="background-color: #FAF9F6; border-color: #D4A37333;">
      <div class="text-xs sm:text-sm text-gray-600 mb-1">총 수익률</div>
      <div class="text-lg sm:text-2xl font-bold" style="color: <%= result[:total_return] >= 0 ? '#10B981' : '#EF4444' %>;">
        <%= number_with_precision(result[:total_return], precision: 2) %>%
      </div>
    </div>
    
    <div class="p-2 sm:p-4 rounded-lg border" style="background-color: #FAF9F6; border-color: #D4A37333;">
      <div class="text-xs sm:text-sm text-gray-600 mb-1">최종 자산 가치</div>
      <div class="text-lg sm:text-2xl font-bold" style="color: #433E3F;">
        $<%= number_to_currency(result[:final_value_usd], unit: "", precision: 0, delimiter: ",") %>
      </div>
    </div>
    
    <div class="p-2 sm:p-4 rounded-lg border" style="background-color: #FAF9F6; border-color: #D4A37333;">
      <div class="text-xs sm:text-sm text-gray-600 mb-1">최대 낙폭 (MDD)</div>
      <div class="text-lg sm:text-2xl font-bold" style="color: #EF4444;">
        <%= number_with_precision(result[:max_drawdown], precision: 2) %>%
      </div>
    </div>
  </div>

  <%# 차트 섹션 %>
  <div class="mb-4 sm:mb-6 grid grid-cols-1 gap-4 sm:gap-6">
    <%# 포트폴리오 가치 추이 차트 %>
    <div>
      <h3 class="text-xs sm:text-lg font-semibold mb-2 sm:mb-4 px-1 sm:px-0" style="color: #433E3F;">포트폴리오 가치 추이</h3>
      <div class="bg-white p-2 sm:p-4 rounded-lg border" style="border-color: #D4A37333;">
        <%= line_chart(
          result[:portfolio_values].map { |pv| [pv[:date].to_s, pv[:portfolio_value_usd]] }.to_h,
          height: "300px",
          colors: ["#D4A373"],
          library: {
            title: "포트폴리오 가치 (달러)",
            hAxis: { title: "날짜" },
            vAxis: { 
              title: "가치 ($)",
              format: "currency"
            },
            legend: { position: "none" }
          }
        ) %>
      </div>
    </div>

    <%# 일별 수익률 차트 %>
    <div>
      <h3 class="text-xs sm:text-lg font-semibold mb-2 sm:mb-4" style="color: #433E3F;">일별 수익률</h3>
      <div class="bg-white p-1.5 sm:p-4 rounded-lg border" style="border-color: #D4A37333;">
        <% 
          # 일별 수익률 계산: 전일 대비 수익률 (실제 달러 가치 기준)
          daily_returns = {}
          result[:portfolio_values].each_with_index do |pv, index|
            if index == 0
              # 첫날은 0% (시작일이므로 전일 대비 수익률 없음)
              daily_returns[pv[:date].to_s] = 0.0
            else
              # 전일 포트폴리오 가치
              prev_pv = result[:portfolio_values][index - 1]
              prev_value = prev_pv[:portfolio_value_usd]
              current_value = pv[:portfolio_value_usd]
              
              # 일별 수익률 = ((오늘 가치 - 어제 가치) / 어제 가치) * 100
              if prev_value > 0
                daily_return = ((current_value - prev_value) / prev_value) * 100.0
                daily_returns[pv[:date].to_s] = daily_return.round(2)
              else
                daily_returns[pv[:date].to_s] = 0.0
              end
            end
          end
        %>
        <%= line_chart(
          daily_returns,
          height: "300px",
          colors: ["#10B981"],
          library: {
            title: "일별 수익률 (%)",
            hAxis: { title: "날짜" },
            vAxis: {
              title: "수익률 (%)",
              baseline: 0,
              baselineColor: "#EF4444"
            },
            legend: { position: "none" }
          }
        ) %>
      </div>
    </div>
  </div>

  <%# 상세 데이터 테이블 (선택사항) %>
  <div class="mt-4 sm:mt-6">
    <details class="cursor-pointer">
      <summary class="text-sm sm:text-lg font-semibold mb-2 sm:mb-4 px-1 sm:px-0" style="color: #433E3F;">
        상세 데이터 보기
      </summary>
      <div class="mt-2 sm:mt-4 overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-2 sm:px-4 py-2 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase">날짜</th>
              <th class="px-2 sm:px-4 py-2 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase">포트폴리오 가치 ($)</th>
              <% if result[:portfolio_values].first && result[:portfolio_values].first[:ticker_values].present? %>
                <% result[:portfolio_values].first[:ticker_values].keys.each do |ticker| %>
                  <th class="px-2 sm:px-4 py-2 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= ticker %> ($)</th>
                <% end %>
              <% end %>
              <th class="px-2 sm:px-4 py-2 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase">현금 ($)</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
                  <% result[:portfolio_values].each do |pv| %>
                    <tr>
                      <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm" style="color: #433E3F;"><%= pv[:date] %></td>
                      <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm font-semibold" style="color: #433E3F;">
                        $<%= number_with_precision(pv[:portfolio_value_usd], precision: 2, delimiter: ",") %>
                      </td>
                      <% pv[:ticker_values].each do |ticker, value| %>
                        <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm text-gray-600">
                          $<%= number_with_precision(value, precision: 2, delimiter: ",") %>
                        </td>
                      <% end %>
                      <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm text-gray-600">
                        $<%= number_with_precision(pv[:cash_value], precision: 2, delimiter: ",") %>
                      </td>
                    </tr>
                  <% end %>
          </tbody>
        </table>
      </div>
    </details>
  </div>
</div>
