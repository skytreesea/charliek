<div class="max-w-4xl mx-auto px-1 sm:px-4 py-4 sm:py-8">
  <%# 공유 전용 요약 카드 %>
  <% 
    ticker_names = @tickers.map { |t| Stock.display_name(t) }.join(', ')
    start_date_formatted = Date.parse(@start_date.to_s).strftime('%Y년 %m월 %d일')
    end_date_formatted = Date.parse(@end_date.to_s).strftime('%Y년 %m월 %d일')
    final_value_formatted = number_to_currency(@result[:final_value_usd], unit: "$", precision: 0, delimiter: ",")
    return_percentage = @result[:total_return] >= 0 ? "+#{@result[:total_return]}" : @result[:total_return].to_s
    
    # MDD 발생 날짜 및 최저 가치 계산
    mdd_date = nil
    mdd_value = @result[:max_drawdown]
    mdd_portfolio_value = nil
    if @result[:portfolio_values] && @result[:portfolio_values].any?
      max_value = 0
      max_value_date = nil
      mdd_date = nil
      max_drawdown = 0
      
      @result[:portfolio_values].each do |pv|
        value = pv[:portfolio_value_usd]
        if value > max_value
          max_value = value
          max_value_date = pv[:date]
        end
        
        if max_value > 0
          drawdown = ((max_value - value) / max_value * 100).round(2)
          if drawdown > max_drawdown
            max_drawdown = drawdown
            mdd_date = pv[:date]
            mdd_portfolio_value = value
          end
        end
      end
    end
    
    mdd_date_formatted = mdd_date ? mdd_date.strftime('%Y년 %m월 %d일') : end_date_formatted
    mdd_value_formatted = mdd_portfolio_value ? number_to_currency(mdd_portfolio_value, unit: "$", precision: 2, delimiter: ",") : "$0"
    
    summary_text = "#{start_date_formatted}에 #{ticker_names}에 $1,000를 투자했다면, #{end_date_formatted}에는 #{final_value_formatted}(#{return_percentage}%)가 되었습니다. #{mdd_date_formatted}에는 #{mdd_value_formatted}까지 떨어지는 것을 견뎌야 했죠."
  %>
  
  <div class="bg-white rounded-xl shadow-lg border-2 p-2 sm:p-8 mb-3 sm:mb-8" style="border-color: #D4A373; background: linear-gradient(to bottom right, #FFFFFF, #FAF9F6);">
    <div class="text-center">
      <h1 class="text-base sm:text-3xl font-bold mb-2 sm:mb-6" style="color: #433E3F;">📊 주식타임머신 결과</h1>
      
      <div class="mb-3 sm:mb-6 p-2 sm:p-6 rounded-lg bg-white border" style="border-color: #D4A37333;">
        <p class="text-sm sm:text-2xl font-semibold leading-relaxed" style="color: #433E3F;">
          <%= summary_text %>
        </p>
      </div>
      
      <%# 주요 지표 요약 %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-1.5 sm:gap-4 mb-3 sm:mb-6">
        <div class="p-2 sm:p-4 rounded-lg border" style="background-color: #FAF9F6; border-color: #D4A37333;">
          <div class="text-xs sm:text-sm text-gray-600 mb-1">총 수익률</div>
          <div class="text-base sm:text-2xl font-bold" style="color: <%= @result[:total_return] >= 0 ? '#10B981' : '#EF4444' %>;">
            <%= number_with_precision(@result[:total_return], precision: 2) %>%
          </div>
        </div>
        
        <div class="p-2 sm:p-4 rounded-lg border" style="background-color: #FAF9F6; border-color: #D4A37333;">
          <div class="text-xs sm:text-sm text-gray-600 mb-1">최종 자산 가치</div>
          <div class="text-base sm:text-2xl font-bold" style="color: #433E3F;">
            <%= number_to_currency(@result[:final_value_usd], unit: "$", precision: 0, delimiter: ",") %>
          </div>
        </div>
        
        <div class="p-2 sm:p-4 rounded-lg border" style="background-color: #FAF9F6; border-color: #D4A37333;">
          <div class="text-xs sm:text-sm text-gray-600 mb-1">최대 낙폭 (MDD)</div>
          <div class="text-base sm:text-2xl font-bold" style="color: #EF4444;">
            <%= number_with_precision(@result[:max_drawdown], precision: 2) %>%
          </div>
        </div>
      </div>
      
      <%# 포트폴리오 구성 정보 %>
      <div class="mt-3 sm:mt-6 p-2 sm:p-4 rounded-lg bg-gray-50 border" style="border-color: #D4A37333;">
        <h3 class="text-xs sm:text-sm font-semibold mb-2" style="color: #433E3F;">포트폴리오 구성</h3>
        <div class="text-xs sm:text-sm text-gray-600">
          <p>기간: <%= Date.parse(@start_date.to_s).strftime('%Y-%m-%d') %> ~ <%= Date.parse(@end_date.to_s).strftime('%Y-%m-%d') %></p>
          <p>종목: <%= ticker_names %></p>
          <% if @cash_weight > 0 %>
            <p>현금 비중: <%= number_with_precision(@cash_weight, precision: 1) %>%</p>
          <% end %>
        </div>
      </div>
      
      <div class="mt-3 sm:mt-6">
        <a 
          href="<%= backtests_path %>" 
          class="inline-block px-4 sm:px-6 py-2 sm:py-3 bg-blue-600 text-white rounded-lg text-sm sm:text-base font-semibold hover:bg-blue-700 transition shadow-md"
        >
          나도 주식타임머신 해보기 →
        </a>
      </div>
    </div>
  </div>
  
  <%# 전체 결과 표시 (선택사항) %>
  <div class="bg-white rounded-xl shadow-md border p-2 sm:p-8" style="border-color: #D4A37333;">
    <h2 class="text-base sm:text-xl font-bold mb-2 sm:mb-4" style="color: #433E3F;">상세 결과</h2>
    
    <%# 차트 섹션 %>
    <div class="mb-3 sm:mb-6">
      <h3 class="text-xs sm:text-lg font-semibold mb-2 sm:mb-4" style="color: #433E3F;">포트폴리오 가치 추이</h3>
      <div class="bg-white p-1.5 sm:p-4 rounded-lg border" style="border-color: #D4A37333;">
        <%= line_chart(
          @result[:portfolio_values].map { |pv| [pv[:date].to_s, pv[:portfolio_value_usd]] }.to_h,
          height: "300px",
          colors: ["#D4A373"],
          library: {
            title: "포트폴리오 가치 (달러)",
            hAxis: { title: "날짜" },
            vAxis: { 
              title: "가치 ($)",
              format: "currency"
            },
            legend: { position: "none" }
          }
        ) %>
      </div>
    </div>
  </div>
</div>
