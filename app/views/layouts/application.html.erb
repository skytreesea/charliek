                      이미지 업로드
                    <% end %>
                  </div>
                </div>
                <script>
                  function toggleAdminMenuMobile() {
                    const menu = document.getElementById('admin-menu-mobile');
                    menu.classList.toggle('hidden');
                  }
                  // 메뉴 외부 클릭 시 닫기
                  document.addEventListener('click', function(event) {
                    const button = document.getElementById('admin-menu-button-mobile');
                    const menu = document.getElementById('admin-menu-mobile');
                    if (button && menu && !button.contains(event.target) && !menu.contains(event.target)) {
                      menu.classList.add('hidden');
                    }
                  });
                </script>
              <% end %>
              <%# My 버튼 + 냥(코인) 표시 - 푸른색 계열 %>
              <%= link_to "My", "/nickname/edit", class: "text-xs font-semibold px-0.5 py-0.5 rounded transition", style: "background-color: #4A90E2; color: white; display: inline-block; text-decoration: none;", onmouseover: "this.style.backgroundColor='#357ABD';", onmouseout: "this.style.backgroundColor='#4A90E2';" %>
              <span class="text-xs font-semibold px-0.5 py-0.5 rounded" style="background-color: #E8D5B7; color: #433E3F;" title="냥 (코인)">🪙 <%= current_user.coins_display %></span>
              <%= link_to "로그아웃", "/users/sign_out", data: { turbo_method: :delete }, class: "text-xs font-semibold px-0.5 py-0.5 rounded transition", style: "color: var(--theme-text);", onmouseover: "this.style.backgroundColor='var(--theme-hover)';", onmouseout: "this.style.backgroundColor='transparent';" %>
            <% else %>
              <%# 로그인 버튼 - 푸른색 계열 %>
              <%= link_to "로그인", "/users/sign_in", class: "text-xs font-semibold px-0.5 py-0.5 rounded transition", style: "background-color: #4A90E2; color: white; display: inline-block; text-decoration: none;", onmouseover: "this.style.backgroundColor='#357ABD';", onmouseout: "this.style.backgroundColor='#4A90E2';" %>
              <%# 회원가입 버튼 - 옅은 녹색 계열 %>
              <%= link_to "회원가입", "/users/sign_up", class: "text-xs font-semibold px-0.5 py-0.5 rounded transition", style: "background-color: #98FB98; color: #2D5016; display: inline-block; text-decoration: none;", onmouseover: "this.style.backgroundColor='#87E887';", onmouseout: "this.style.backgroundColor='#98FB98';" %>
              <%# 사이트맵 링크 - 회원가입 오른쪽 (모바일) %>
              <%= link_to "사이트맵", "/sitemap.xml", class: "text-xs font-semibold px-0.5 py-0.5 rounded transition", style: "color: var(--theme-text);", onmouseover: "this.style.backgroundColor='var(--theme-hover)';", onmouseout: "this.style.backgroundColor='transparent';", target: "_blank", rel: "noopener noreferrer" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <div class="flex flex-1 overflow-x-hidden">
      <main class="flex-1 w-full max-w-full mx-auto py-1 sm:py-2 px-1 sm:px-2" style="max-width: 1280px;">
        <%= yield %>
      </main>
      
      <%# 사이드바 (넓은 화면에서만 표시, 게시판 페이지에서만) %>
      <% if request.path.start_with?('/posts') %>
      <aside id="sidebar" class="hidden xl:block w-80 bg-white border-l-2" style="border-color: var(--theme-border); position: sticky; align-self: flex-start;">
        <%# Fragment 캐싱: 카테고리별로 캐시 키 생성 %>
        <% cache_key = "sidebar_content_#{params[:category] || 'default'}_#{Post.maximum(:id) || 0}_#{Post.maximum(:updated_at)&.to_i}" %>
        <% cache cache_key, expires_in: 15.minutes do %>
          <div class="p-4 space-y-3">
            <%# 카테고리 네비게이션 (Dropdown 방식) - 맨 위로 이동 %>
            <div>
              <h3 class="text-base font-bold mb-2" style="color: var(--theme-text);">카테고리 바로가기</h3>
              <div class="relative">
                <% categories = ["주식", "문화", "출판", "Rails", "자유게시판", "생각들"] %>
                <% current_category = params[:category] || "주식" %>
                <button 
                  id="category-dropdown-button" 
                  class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-semibold transition category-dropdown-button"
                  style="background-color: var(--theme-primary); color: white;"
                  onclick="toggleCategoryDropdown()"
                >
                  <span><%= current_category %></span>
                  <svg class="w-4 h-4 transition-transform" id="category-dropdown-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
                <div id="category-dropdown-menu" class="hidden absolute top-full left-0 right-0 mt-1 bg-white rounded-lg shadow-lg border z-50 category-dropdown-menu" style="border-color: var(--theme-border);">
                  <nav class="py-1">
                    <% categories.each do |category| %>
                      <% if category != current_category %>
                        <%= link_to "/posts?category=#{CGI.escape(category)}", 
                            class: "block px-3 py-2 text-sm transition category-dropdown-item",
                            style: "color: var(--theme-text);",
                            onmouseover: "this.style.backgroundColor='var(--theme-hover)';",
                            onmouseout: "this.style.backgroundColor='transparent';" do %>
                          <%= category %>
                        <% end %>
                      <% end %>
                    <% end %>
                  </nav>
                </div>
              </div>
            </div>

            <%# 최신 글 (먼저 표시) %>
            <div>
              <h3 class="text-base font-bold mb-2 sidebar-section-title">최신 글</h3>
              <div class="space-y-1.5">
                <% @recent_posts.each do |post| %>
                  <%= link_to post_path(post), class: "block" do %>
                    <div class="px-3 py-1.5 rounded-lg transition truncate" style="background-color: var(--theme-bg);" title="<%= post.title %>" onmouseover="this.style.backgroundColor='var(--theme-hover)';" onmouseout="this.style.backgroundColor='var(--theme-bg)';">
                      <p class="text-sm text-gray-800 truncate"><%= post.title %></p>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>

            <%# 인기 글 (나중에 표시) %>
            <div>
              <h3 class="text-base font-bold mb-2 sidebar-section-title">인기 글</h3>
              <div class="space-y-1.5">
                <% @popular_posts.each do |post| %>
                  <%# N+1 쿼리 방지: slug가 이미 로드되어 있으므로 to_param에서 추가 쿼리 없음 %>
                  <% post.instance_variable_set(:@_skip_slug_generation, true) if post.slug.blank? %>
                  <%= link_to post_path(post), class: "block" do %>
                    <div class="px-3 py-1.5 rounded-lg transition truncate" style="background-color: var(--theme-bg);" title="<%= post.title %>" onmouseover="this.style.backgroundColor='var(--theme-hover)';" onmouseout="this.style.backgroundColor='var(--theme-bg)';">
                      <p class="text-sm text-gray-800 truncate"><%= post.title %></p>
                      <p class="text-xs text-gray-500 mt-0.5">조회수: <%= format_number_short(post.views_count || 0) %></p>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
          
          <script>
            function toggleCategoryDropdown() {
              const menu = document.getElementById('category-dropdown-menu');
              const arrow = document.getElementById('category-dropdown-arrow');
              menu.classList.toggle('hidden');
              arrow.classList.toggle('rotate-180');
            }
            
            // 메뉴 외부 클릭 시 닫기
            document.addEventListener('click', function(event) {
              const button = document.getElementById('category-dropdown-button');
              const menu = document.getElementById('category-dropdown-menu');
              if (button && menu && !button.contains(event.target) && !menu.contains(event.target)) {
                menu.classList.add('hidden');
                document.getElementById('category-dropdown-arrow')?.classList.remove('rotate-180');
              }
            });
            
          </script>
        <% end %>
      </aside>
      <% end %>
      
      <%# 사이드바 sticky 위치 조정 스크립트 (캐시 밖) %>
      <script>
        // 사이드바 sticky 위치 동적 조정
        function updateSidebarPosition() {
          const sidebar = document.getElementById('sidebar');
          const nav = document.querySelector('nav');
          if (sidebar && nav) {
            const navHeight = nav.offsetHeight;
            sidebar.style.top = navHeight + 'px';
          }
        }
        
        // 페이지 로드 시 및 리사이즈 시 실행
        function initSidebarPosition() {
          const sidebar = document.getElementById('sidebar');
          if (sidebar) {
            // 즉시 실행
            updateSidebarPosition();
            // 이벤트 리스너 등록
            window.addEventListener('resize', updateSidebarPosition);
            // Turbo 이벤트도 처리 (Rails 7+)
            document.addEventListener('turbo:load', updateSidebarPosition);
            document.addEventListener('turbo:render', updateSidebarPosition);
          }
        }
        
        // DOMContentLoaded 또는 즉시 실행
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initSidebarPosition);
        } else {
          initSidebarPosition();
        }
      </script>
    </div>

    <%# 푸터 영역 %>
