<!DOCTYPE html>
<html>
  <head>
    <%# Dynamic Title: 컨트롤러에서 설정한 @page_title 우선 사용 %>
    <% page_title = @page_title || content_for(:title) || "CharlieK" %>
    <% unless page_title.include?("|") %>
      <% page_title = "#{page_title} | CharlieK" %>
    <% end %>
    <title><%= page_title %></title>
    
    <%# Meta Description: 컨트롤러에서 설정한 @meta_description 우선 사용 %>
    <% meta_description = @meta_description || content_for(:meta_description) || @og_description || "Charlie K Archive - 주식 분석, 문화, 출판, Rails 개발 등 다양한 콘텐츠를 제공합니다." %>
    <meta name="description" content="<%= meta_description.truncate(160) %>">
    
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="CharlieK">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google AdSense 메타 태그 -->
    <meta name="google-adsense-account" content="ca-pub-4806760103635874">

    <!-- Google AdSense (최우선 로드: 다른 스크립트보다 먼저) -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4806760103635874" crossorigin="anonymous"></script>

    <%# Open Graph 메타 태그 (페이스북, 트위터 등 소셜 미디어 공유용) %>
    <% og_title = defined?(@og_title) && @og_title.present? ? @og_title : (content_for(:title) || "CharlieK") %>
    <meta property="og:title" content="<%= og_title %>">
    
    <% og_description = defined?(@og_description) && @og_description.present? ? @og_description : meta_description %>
    <meta property="og:description" content="<%= og_description.truncate(200) %>">
    
    <% if defined?(@og_image) && @og_image.present? %>
      <meta property="og:image" content="<%= @og_image %>">
    <% else %>
      <meta property="og:image" content="<%= "#{request.base_url}/icon.png" %>">
    <% end %>
    
    <% if defined?(@og_url) && @og_url.present? %>
      <meta property="og:url" content="<%= @og_url %>">
    <% else %>
      <meta property="og:url" content="<%= request.base_url %><%= request.path %>">
    <% end %>
    
    <% if defined?(@og_type) && @og_type.present? %>
      <meta property="og:type" content="<%= @og_type %>">
    <% else %>
      <meta property="og:type" content="website">
    <% end %>
    <%# 네이버 블로그 검색 시 가독성을 위한 사이트명 설정 %>
    <meta property="og:site_name" content="Charlie K Archive">
    
    <%# Article 메타 태그 (게시물인 경우) %>
    <% if defined?(@og_type) && @og_type == "article" %>
      <% if defined?(@article_published_time) && @article_published_time.present? %>
        <meta property="article:published_time" content="<%= @article_published_time %>">
      <% end %>
      <% if defined?(@article_author) && @article_author.present? %>
        <meta property="article:author" content="<%= @article_author %>">
      <% end %>
      <% if defined?(@article_section) && @article_section.present? %>
        <meta property="article:section" content="<%= @article_section %>">
      <% end %>
    <% end %>
    
    <%# Twitter Card 메타 태그 %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= og_title %>">
    <meta name="twitter:description" content="<%= og_description.truncate(200) %>">
    <% if defined?(@og_image) && @og_image.present? %>
      <meta name="twitter:image" content="<%= @og_image %>">
    <% else %>
      <meta name="twitter:image" content="<%= "#{request.base_url}/icon.png" %>">
    <% end %>
    <meta name="twitter:site" content="@charliek">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# Google Fonts preconnect (성능 최적화) %>
    <% if @font_urls.present? %>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <% @font_urls.uniq.each do |font_url| %>
        <%= tag.link rel: "stylesheet", href: font_url %>
      <% end %>
    <% end %>

    <%# 동적 CSS 변수 설정 %>
    <style>
      :root {
        --theme-bg: <%= @theme_colors && @theme_colors[:bg] ? @theme_colors[:bg] : '#FAF9F6' %>;
        --theme-card: <%= @theme_colors && @theme_colors[:card] ? @theme_colors[:card] : '#FFFFFF' %>;
        --theme-primary: <%= @theme_colors && @theme_colors[:primary] ? @theme_colors[:primary] : '#D4A373' %>;
        --theme-text: <%= @theme_colors && @theme_colors[:text] ? @theme_colors[:text] : '#433E3F' %>;
        --theme-border: <%= @theme_colors && @theme_colors[:border] ? @theme_colors[:border] : 'rgba(212, 163, 115, 0.2)' %>;
        --theme-hover: <%= @theme_colors && @theme_colors[:hover] ? @theme_colors[:hover] : 'rgba(212, 163, 115, 0.15)' %>;
        --font-heading: <%= @theme_fonts && @theme_fonts[:heading] ? @theme_fonts[:heading] : 'system-ui, sans-serif' %>;
        --font-body: <%= @theme_fonts && @theme_fonts[:body] ? @theme_fonts[:body] : 'system-ui, sans-serif' %>;
        --font-button: <%= @theme_fonts && @theme_fonts[:button] ? @theme_fonts[:button] : 'system-ui, sans-serif' %>;
        --font-link: <%= @theme_fonts && @theme_fonts[:link] ? @theme_fonts[:link] : 'system-ui, sans-serif' %>;
        --font-nav: <%= @theme_fonts && @theme_fonts[:nav] ? @theme_fonts[:nav] : 'system-ui, sans-serif' %>;
        --font-code: <%= @theme_fonts && @theme_fonts[:code] ? @theme_fonts[:code] : "'Courier New', monospace" %>;
        --font-footer: <%= @theme_fonts && @theme_fonts[:footer] ? @theme_fonts[:footer] : 'system-ui, sans-serif' %>;
      }
      
      /* 다크모드 스타일 */
      html[data-theme="dark"] {
        --theme-bg: #1a1a1a;
        --theme-card: #2d2d2d;
        --theme-text: #e5e5e5;
        --theme-border: rgba(212, 163, 115, 0.3);
        --theme-hover: rgba(212, 163, 115, 0.2);
      }
      
      /* 다크모드: 인기글/최신글 제목 바 스타일 */
      html[data-theme="dark"] .sidebar-section-title {
        color: white !important;
        background-color: #8B4513 !important;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
      }
      
      /* 다크모드: 카테고리 드롭다운 버튼 스타일 */
      html[data-theme="dark"] .category-dropdown-button {
        background-color: #654321 !important;
        color: white !important;
      }
      
      /* 다크모드: 카테고리 드롭다운 메뉴 스타일 */
      html[data-theme="dark"] .category-dropdown-menu {
        background-color: #A0522D !important;
        border-color: #654321 !important;
      }
      
      /* 다크모드: 카테고리 드롭다운 메뉴 항목 스타일 */
      html[data-theme="dark"] .category-dropdown-item {
        color: white !important;
      }
      
      html[data-theme="dark"] .category-dropdown-item:hover {
        background-color: #8B4513 !important;
      }
      
      /* 기본 배경 - 가장 중요! */
      html[data-theme="dark"],
      html[data-theme="dark"] body {
        background-color: #1a1a1a !important;
        color: #e5e5e5 !important;
      }
      
      /* 모든 요소의 기본 텍스트 색상 */
      html[data-theme="dark"] * {
        color: inherit;
      }
      
      /* 네비게이션 */
      html[data-theme="dark"] nav {
        background-color: #2d2d2d !important;
        border-color: rgba(212, 163, 115, 0.3) !important;
        color: #e5e5e5 !important;
      }
      
      /* 배경색 클래스들 - 강제 적용 */
      html[data-theme="dark"] .bg-white,
      html[data-theme="dark"] .bg-gray-50,
      html[data-theme="dark"] .bg-blue-50,
      html[data-theme="dark"] .bg-gray-100,
      html[data-theme="dark"] .bg-gray-200,
      html[data-theme="dark"] .bg-gray-300 {
        background-color: #2d2d2d !important;
        color: #e5e5e5 !important;
      }
      
      /* 텍스트 색상 클래스들 */
      html[data-theme="dark"] .text-gray-600,
      html[data-theme="dark"] .text-gray-500,
      html[data-theme="dark"] .text-gray-700,
      html[data-theme="dark"] .text-gray-800,
      html[data-theme="dark"] .text-gray-900,
      html[data-theme="dark"] .text-black {
        color: #e5e5e5 !important;
      }
      
      html[data-theme="dark"] .text-gray-400 {
        color: #a0a0a0 !important;
      }
      
      /* 입력 필드 */
      html[data-theme="dark"] input[type="text"],
      html[data-theme="dark"] input[type="email"],
      html[data-theme="dark"] input[type="password"],
      html[data-theme="dark"] input[type="number"],
      html[data-theme="dark"] input[type="search"],
      html[data-theme="dark"] textarea,
      html[data-theme="dark"] select {
        background-color: #2d2d2d !important;
        color: #e5e5e5 !important;
        border-color: rgba(212, 163, 115, 0.3) !important;
      }
      
      html[data-theme="dark"] input::placeholder,
      html[data-theme="dark"] textarea::placeholder {
        color: #a0a0a0 !important;
      }
      
      /* 카드 및 컨테이너 - 모든 rounded와 shadow 요소 */
      html[data-theme="dark"] .rounded-xl,
      html[data-theme="dark"] .rounded-lg,
      html[data-theme="dark"] .rounded-md,
      html[data-theme="dark"] .rounded,
      html[data-theme="dark"] .shadow-lg,
      html[data-theme="dark"] .shadow-md,
      html[data-theme="dark"] .shadow-sm,
      html[data-theme="dark"] .shadow {
        background-color: #2d2d2d !important;
        border-color: rgba(212, 163, 115, 0.3) !important;
        color: #e5e5e5 !important;
      }
      
      /* 모든 div 요소 */
      html[data-theme="dark"] div {
        color: #e5e5e5;
      }
      
      /* 테두리 */
      html[data-theme="dark"] .border,
      html[data-theme="dark"] .border-2,
      html[data-theme="dark"] .border-t,
      html[data-theme="dark"] .border-b,
      html[data-theme="dark"] .border-gray-300,
      html[data-theme="dark"] .border-gray-200 {
        border-color: rgba(212, 163, 115, 0.3) !important;
      }
      
      /* 링크 */
      html[data-theme="dark"] a {
        color: #e5e5e5 !important;
      }
      
      html[data-theme="dark"] a:hover {
        color: #D4A373 !important;
      }
      
      /* 버튼 - 모든 버튼 스타일 */
      html[data-theme="dark"] button {
        background-color: #2d2d2d !important;
        color: #e5e5e5 !important;
        border-color: rgba(212, 163, 115, 0.3) !important;
      }
      
      /* 특정 배경색이 있는 버튼은 유지하되 텍스트만 밝게 */
      html[data-theme="dark"] button[style*="background-color: #D4A373"],
      html[data-theme="dark"] button[style*="background-color:#D4A373"],
      html[data-theme="dark"] button[style*="background-color: #4A90E2"],
      html[data-theme="dark"] button[style*="background-color:#4A90E2"],
      html[data-theme="dark"] button[style*="background-color: #FF8C00"],
      html[data-theme="dark"] button[style*="background-color:#FF8C00"] {
        color: white !important;
      }
      
      /* 푸터 */
      html[data-theme="dark"] footer {
        background-color: #2d2d2d !important;
        color: #e5e5e5 !important;
        border-color: rgba(212, 163, 115, 0.3) !important;
      }
      
      /* 코드 블록 */
      html[data-theme="dark"] code,
      html[data-theme="dark"] pre {
        background-color: #1a1a1a !important;
        color: #e5e5e5 !important;
        border-color: rgba(212, 163, 115, 0.3) !important;
      }
      
      /* 테이블 */
      html[data-theme="dark"] table {
        background-color: #2d2d2d !important;
        color: #e5e5e5 !important;
      }
      
      html[data-theme="dark"] th,
      html[data-theme="dark"] td {
        border-color: rgba(212, 163, 115, 0.3) !important;
        color: #e5e5e5 !important;
      }
      
      /* 제목 요소들 */
      html[data-theme="dark"] h1,
      html[data-theme="dark"] h2,
      html[data-theme="dark"] h3,
      html[data-theme="dark"] h4,
      html[data-theme="dark"] h5,
      html[data-theme="dark"] h6 {
        color: #e5e5e5 !important;
      }
      
      /* 리스트 */
      html[data-theme="dark"] ul,
      html[data-theme="dark"] ol,
      html[data-theme="dark"] li {
        color: #e5e5e5 !important;
      }
      
      /* p 태그 */
      html[data-theme="dark"] p {
        color: #e5e5e5 !important;
      }
      
      /* span 태그 */
      html[data-theme="dark"] span {
        color: inherit;
      }
      
      /* 인라인 스타일이 있는 요소들 - 강제 오버라이드 */
      html[data-theme="dark"] [style*="background-color: #FFFFFF"],
      html[data-theme="dark"] [style*="background-color:#FFFFFF"],
      html[data-theme="dark"] [style*="background-color: #FAF9F6"],
      html[data-theme="dark"] [style*="background-color:#FAF9F6"] {
        background-color: #2d2d2d !important;
        color: #e5e5e5 !important;
      }
      
      html[data-theme="dark"] [style*="color: #433E3F"],
      html[data-theme="dark"] [style*="color:#433E3F"],
      html[data-theme="dark"] [style*="color: #9CA3AF"],
      html[data-theme="dark"] [style*="color:#9CA3AF"],
      html[data-theme="dark"] [style*="color: #6B7280"],
      html[data-theme="dark"] [style*="color:#6B7280"] {
        color: #e5e5e5 !important;
      }
      
      html[data-theme="dark"] [style*="border-color: #D4A373"],
      html[data-theme="dark"] [style*="border-color:#D4A373"],
      html[data-theme="dark"] [style*="border-color: #D4A37333"],
      html[data-theme="dark"] [style*="border-color:#D4A37333"] {
        border-color: rgba(212, 163, 115, 0.3) !important;
      }
      
      /* 배경 그라디언트 */
      html[data-theme="dark"] [style*="background: linear-gradient"],
      html[data-theme="dark"] [style*="background:linear-gradient"] {
        background: #2d2d2d !important;
      }
      
      /* section, article, main, aside */
      html[data-theme="dark"] section,
      html[data-theme="dark"] article,
      html[data-theme="dark"] main,
      html[data-theme="dark"] aside {
        background-color: transparent !important;
        color: #e5e5e5 !important;
      }
      
      /* 게시판 영역 - 어두운 브라운톤 배경 */
      html[data-theme="dark"] .bg-white.rounded-xl,
      html[data-theme="dark"] .bg-white.rounded-lg,
      html[data-theme="dark"] .bg-white.rounded-md,
      html[data-theme="dark"] .bg-white.rounded {
        background-color: #3a2e22 !important; /* 어두운 브라운톤 */
        color: #e5e5e5 !important;
      }
      
      /* 게시판 내부 행/항목 - 약간 더 밝은 브라운톤 */
      html[data-theme="dark"] [style*="background-color: white"],
      html[data-theme="dark"] [style*="background-color:#FFFFFF"],
      html[data-theme="dark"] [style*="background-color: white;"],
      html[data-theme="dark"] [style*="background-color:#FFFFFF;"] {
        background-color: #3a2e22 !important; /* 어두운 브라운톤 */
        color: #e5e5e5 !important;
      }
      
      /* 게시판 호버 효과 - 약간 밝은 브라운톤 */
      html[data-theme="dark"] [onmouseover*="backgroundColor='#FAF9F6'"],
      html[data-theme="dark"] [onmouseover*="backgroundColor=\"#FAF9F6\""] {
        transition: background-color 0.2s ease;
      }
      
      html[data-theme="dark"] [onmouseover*="backgroundColor='#FAF9F6'"]:hover,
      html[data-theme="dark"] [onmouseover*="backgroundColor=\"#FAF9F6\""]:hover {
        background-color: #4a3d30 !important; /* 호버 시 약간 밝은 브라운톤 */
      }
      
      /* 게시판 내부 텍스트 - 밝게 */
      html[data-theme="dark"] .bg-white *,
      html[data-theme="dark"] [style*="background-color: white"] *,
      html[data-theme="dark"] [style*="background-color:#FFFFFF"] * {
        color: #e5e5e5 !important;
      }
      
      /* 게시판 제목과 텍스트 */
      html[data-theme="dark"] .bg-white h1,
      html[data-theme="dark"] .bg-white h2,
      html[data-theme="dark"] .bg-white h3,
      html[data-theme="dark"] .bg-white p,
      html[data-theme="dark"] .bg-white span,
      html[data-theme="dark"] .bg-white div,
      html[data-theme="dark"] [style*="background-color: white"] h1,
      html[data-theme="dark"] [style*="background-color: white"] h2,
      html[data-theme="dark"] [style*="background-color: white"] h3,
      html[data-theme="dark"] [style*="background-color: white"] p,
      html[data-theme="dark"] [style*="background-color: white"] span,
      html[data-theme="dark"] [style*="background-color: white"] div {
        color: #e5e5e5 !important;
      }
      
      /* 게시판 내부 링크 */
      html[data-theme="dark"] .bg-white a,
      html[data-theme="dark"] [style*="background-color: white"] a {
        color: #e5e5e5 !important;
      }
      
      html[data-theme="dark"] .bg-white a:hover,
      html[data-theme="dark"] [style*="background-color: white"] a:hover {
        color: #D4A373 !important;
      }
      
      /* 게시판 내부 입력 필드 */
      html[data-theme="dark"] .bg-white input,
      html[data-theme="dark"] .bg-white textarea,
      html[data-theme="dark"] .bg-white select,
      html[data-theme="dark"] [style*="background-color: white"] input,
      html[data-theme="dark"] [style*="background-color: white"] textarea,
      html[data-theme="dark"] [style*="background-color: white"] select {
        background-color: #2d2418 !important; /* 더 어두운 브라운톤 */
        color: #e5e5e5 !important;
        border-color: rgba(212, 163, 115, 0.3) !important;
      }
      
      /* 게시글 상세 페이지의 컨텐츠 영역 */
      html[data-theme="dark"] [style*="background-color: #FAF9F6"],
      html[data-theme="dark"] [style*="background-color:#FAF9F6"] {
        background-color: #3a2e22 !important; /* 어두운 브라운톤 */
        color: #e5e5e5 !important;
      }
      
      html[data-theme="dark"] [style*="background-color: #FAF9F6"] *,
      html[data-theme="dark"] [style*="background-color:#FAF9F6"] * {
        color: #e5e5e5 !important;
      }
      
      /* 주식 타임머신 사용법 안내 영역 - 어두운 브라운톤 */
      html[data-theme="dark"] .bg-gradient-to-r.from-blue-50,
      html[data-theme="dark"] .bg-gradient-to-r.from-indigo-50,
      html[data-theme="dark"] .from-blue-50,
      html[data-theme="dark"] .to-indigo-50 {
        background: #3a2e22 !important; /* 어두운 브라운톤 배경 */
        color: #e5e5e5 !important;
      }
      
      /* 주식 타임머신 사용법 안내 내부 상자들 - 약간 다른 브라운톤으로 차별화 */
      html[data-theme="dark"] .bg-gradient-to-r.from-blue-50 .bg-white,
      html[data-theme="dark"] .bg-gradient-to-r.from-indigo-50 .bg-white,
      html[data-theme="dark"] .from-blue-50 .bg-white,
      html[data-theme="dark"] .to-indigo-50 .bg-white {
        background-color: #4a3d30 !important; /* 약간 밝은 브라운톤 */
        color: #e5e5e5 !important;
        border-color: rgba(212, 163, 115, 0.3) !important;
      }
      
      /* 주식 타임머신 사용법 안내 내부 텍스트 */
      html[data-theme="dark"] .bg-gradient-to-r.from-blue-50 *,
      html[data-theme="dark"] .bg-gradient-to-r.from-indigo-50 *,
      html[data-theme="dark"] .from-blue-50 *,
      html[data-theme="dark"] .to-indigo-50 * {
        color: #e5e5e5 !important;
      }
      
      /* 주식 타임머신 경고 상자 (bg-yellow-50) - 또 다른 브라운톤 */
      html[data-theme="dark"] .bg-yellow-50 {
        background-color: #4d3e2a !important; /* 노란색 계열의 어두운 브라운톤 */
        color: #e5e5e5 !important;
        border-color: rgba(212, 163, 115, 0.4) !important;
      }
      
      html[data-theme="dark"] .bg-yellow-50 * {
        color: #e5e5e5 !important;
      }
      
      html[data-theme="dark"] .border-yellow-200 {
        border-color: rgba(212, 163, 115, 0.4) !important;
      }
      
      body {
