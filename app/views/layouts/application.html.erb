    <%# 다크모드 토글 스크립트 %>
    <script>
      (function() {
        // 다크모드 상태 확인 및 적용
        function initDarkMode() {
          const savedTheme = localStorage.getItem('theme');
          // 기본값을 다크모드로 설정 (저장된 테마가 없으면 다크모드)
          const isDark = savedTheme === 'light' ? false : true;
          
          if (isDark) {
            document.documentElement.setAttribute('data-theme', 'dark');
            updateDarkModeIcon(true);
            applyDarkModeStyles();
            // 저장된 테마가 없으면 다크모드로 저장
            if (!savedTheme) {
              localStorage.setItem('theme', 'dark');
            }
          } else {
            document.documentElement.removeAttribute('data-theme');
            updateDarkModeIcon(false);
            removeDarkModeStyles();
          }
        }
        
        // 다크모드 아이콘 업데이트
        function updateDarkModeIcon(isDark) {
          // 데스크톱 아이콘 업데이트
          const icon = document.getElementById('dark-mode-icon');
          if (icon) {
            if (isDark) {
              // 달 아이콘 (다크모드 활성화 시)
              icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />';
            } else {
              // 태양 아이콘 (라이트모드 시)
              icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />';
            }
          }
          
          // 모바일 아이콘 업데이트
          const iconMobile = document.getElementById('dark-mode-icon-mobile');
          if (iconMobile) {
            if (isDark) {
              // 달 아이콘 (다크모드 활성화 시)
              iconMobile.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />';
            } else {
              // 태양 아이콘 (라이트모드 시)
              iconMobile.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />';
            }
          }
        }
        
        // 인라인 스타일이 있는 요소들에 다크모드 적용
        function applyDarkModeStyles() {
          // 모든 요소를 순회하며 인라인 스타일 강제 적용
          const allElements = document.querySelectorAll('*');
          
          allElements.forEach(el => {
            const style = el.style;
            const bgColor = style.backgroundColor;
            const textColor = style.color;
            const borderColor = style.borderColor;
            const styleAttr = el.getAttribute('style') || '';
            const classList = el.classList;
            
            // 게시판 영역인지 확인
            const isPostBoard = classList.contains('bg-white') && 
                               (el.closest('.bg-white.rounded-xl') !== null ||
                                el.closest('[class*="post"]') !== null ||
                                (styleAttr.includes('background-color: white') && el.closest('.max-w-5xl') !== null));
            
            // 주식 타임머신 사용법 안내 영역인지 확인
            const isBacktestGuide = classList.contains('bg-gradient-to-r') && 
                                   (classList.contains('from-blue-50') || classList.contains('to-indigo-50')) ||
                                   el.closest('.bg-gradient-to-r.from-blue-50') !== null ||
                                   el.closest('.bg-gradient-to-r.from-indigo-50') !== null;
            
            // 주식 타임머신 사용법 안내 내부 상자인지 확인
            const isBacktestGuideBox = classList.contains('bg-white') && 
                                      (el.closest('.bg-gradient-to-r.from-blue-50') !== null ||
                                       el.closest('.bg-gradient-to-r.from-indigo-50') !== null);
            
            // 경고 상자인지 확인
            const isWarningBox = classList.contains('bg-yellow-50');
            
            // 배경색 처리
            if (bgColor && (
              bgColor.includes('#FFFFFF') || 
              bgColor.includes('#FAF9F6') ||
              bgColor.includes('rgb(255, 255, 255)') ||
              bgColor.includes('rgb(250, 249, 246)')
            )) {
              if (!el.dataset.darkModeOriginalBg) {
                el.dataset.darkModeOriginalBg = bgColor;
              }
              // 영역별로 다른 브라운톤 적용
              let darkBg = '#2d2d2d'; // 기본 회색톤
              if (isPostBoard) {
                darkBg = '#3a2e22'; // 게시판 브라운톤
              } else if (isBacktestGuideBox) {
                darkBg = '#4a3d30'; // 사용법 안내 내부 상자 (약간 밝은 브라운톤)
              } else if (isBacktestGuide) {
                darkBg = '#3a2e22'; // 사용법 안내 컨테이너 (어두운 브라운톤)
              }
              el.style.setProperty('background-color', darkBg, 'important');
            }
            
            // 그라디언트 배경 처리 (주식 타임머신 사용법 안내)
            if (isBacktestGuide && (!bgColor || bgColor === 'transparent' || bgColor === 'rgba(0, 0, 0, 0)')) {
              if (!el.dataset.darkModeOriginalBg) {
                el.dataset.darkModeOriginalBg = el.style.background || el.style.backgroundColor || '';
              }
              el.style.setProperty('background', '#3a2e22', 'important');
              el.style.setProperty('background-color', '#3a2e22', 'important');
            }
            
            // 경고 상자 처리
            if (isWarningBox) {
              if (!el.dataset.darkModeOriginalBg) {
                el.dataset.darkModeOriginalBg = bgColor || el.style.background || '';
              }
              el.style.setProperty('background-color', '#4d3e2a', 'important');
              el.style.setProperty('background', '#4d3e2a', 'important');
            }
            
            // 텍스트 색상 처리
            if (textColor && (
              textColor.includes('#433E3F') ||
              textColor.includes('#9CA3AF') ||
              textColor.includes('#6B7280') ||
              textColor.includes('rgb(67, 62, 63)') ||
              textColor.includes('rgb(156, 163, 175)')
            )) {
              if (!el.dataset.darkModeOriginalColor) {
                el.dataset.darkModeOriginalColor = textColor;
              }
              el.style.setProperty('color', '#e5e5e5', 'important');
            }
            
            // 테두리 색상 처리
            if (borderColor && borderColor.includes('#D4A373')) {
              if (!el.dataset.darkModeOriginalBorder) {
                el.dataset.darkModeOriginalBorder = borderColor;
              }
              el.style.setProperty('border-color', 'rgba(212, 163, 115, 0.3)', 'important');
            }
          });
          
          // body와 html의 배경색 강제 설정
          document.body.style.setProperty('background-color', '#1a1a1a', 'important');
          document.documentElement.style.setProperty('background-color', '#1a1a1a', 'important');
          document.body.style.setProperty('color', '#e5e5e5', 'important');
        }
        
        // 다크모드 스타일 제거
        function removeDarkModeStyles() {
          // 원래 스타일 복원
          document.querySelectorAll('[data-dark-mode-original-bg]').forEach(el => {
            el.style.setProperty('background-color', el.dataset.darkModeOriginalBg || '', 'important');
            delete el.dataset.darkModeOriginalBg;
          });
          
          document.querySelectorAll('[data-dark-mode-original-color]').forEach(el => {
            el.style.setProperty('color', el.dataset.darkModeOriginalColor || '', 'important');
            delete el.dataset.darkModeOriginalColor;
          });
          
          document.querySelectorAll('[data-dark-mode-original-border]').forEach(el => {
            el.style.setProperty('border-color', el.dataset.darkModeOriginalBorder || '', 'important');
            delete el.dataset.darkModeOriginalBorder;
          });
          
          // 호버 이벤트 복원
          document.querySelectorAll('[data-dark-mode-original-hover]').forEach(el => {
            el.setAttribute('onmouseover', el.dataset.darkModeOriginalHover || '');
            delete el.dataset.darkModeOriginalHover;
          });
          
          document.querySelectorAll('[data-dark-mode-original-out]').forEach(el => {
            el.setAttribute('onmouseout', el.dataset.darkModeOriginalOut || '');
            delete el.dataset.darkModeOriginalOut;
          });
          
          // body와 html의 배경색 제거
          document.body.style.removeProperty('background-color');
          document.documentElement.style.removeProperty('background-color');
          document.body.style.removeProperty('color');
        }
        
        // 다크모드 토글
        function toggleDarkMode() {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          
          if (isDark) {
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('theme', 'light');
            updateDarkModeIcon(false);
            removeDarkModeStyles();
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('theme', 'dark');
            updateDarkModeIcon(true);
            applyDarkModeStyles();
          }
        }
        
        // 페이지 로드 시 다크모드 초기화
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initDarkMode);
        } else {
          initDarkMode();
        }
        
        // Turbo 이벤트 리스너 (Turbo로 페이지 전환 시에도 다크모드 유지)
        document.addEventListener('turbo:load', function() {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (isDark) {
            applyDarkModeStyles();
          }
        });
        
        // 다크모드 토글 버튼 이벤트 리스너 (데스크톱)
        const toggleButton = document.getElementById('dark-mode-toggle');
        if (toggleButton) {
          toggleButton.addEventListener('click', toggleDarkMode);
        }
        
        // 다크모드 토글 버튼 이벤트 리스너 (모바일)
        const toggleButtonMobile = document.getElementById('dark-mode-toggle-mobile');
        if (toggleButtonMobile) {
          toggleButtonMobile.addEventListener('click', toggleDarkMode);
        }
        
        // 시스템 테마 변경 감지 (선택사항)
        if (window.matchMedia) {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
            if (!localStorage.getItem('theme')) {
              initDarkMode();
            }
          });
        }
      })();
    </script>
    <%# 회원가입 직후 10냥 환영 팝업 (확인 누르면 이미 메인에 있음) %>
    <% if flash[:welcome_coins] %>
      <script>
        (function() {
          alert("축하합니다. 마이뮤즈, 기사생성기를 이용할 수 있는 10냥의 코인이 무료로 주어집니다. 지금 한 번 이용해보세요.");
        })();
      </script>
    <% end %>
  </body>
</html>
