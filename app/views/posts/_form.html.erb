<%# 가장 기본적인 HTML 폼으로 재작성 %>
<% selected_category = post.category.presence || "주식" %>
<% form_action = post.persisted? ? post_path(post) : posts_path %>
<% form_method = post.persisted? ? "patch" : "post" %>

<form id="post-form" action="<%= form_action %>" method="post" enctype="multipart/form-data" class="space-y-4 sm:space-y-6" data-turbo="false" onsubmit="document.getElementById('submit_button').textContent='처리 중...'; document.getElementById('submit_button').disabled=true; return true;">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <% if post.persisted? %>
    <input type="hidden" name="_method" value="patch">
  <% end %>

  <%# 카테고리(10%) + 제목(80%) + 수정/삭제 버튼(10%) 한 줄 배치 %>
  <div class="flex gap-2 sm:gap-3">
    <div class="w-[10%] min-w-[80px]">
      <label for="post_category" class="block text-sm font-medium text-gray-700 mb-1">게시판</label>
      <select name="post[category]" id="post_category" class="w-full px-2 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 text-xs sm:text-sm" style="focus:ring-color: #D4A373; focus:border-color: #D4A373;">
        <% Post::CATEGORIES.each do |cat| %>
          <option value="<%= cat %>" <%= 'selected' if cat == selected_category %>><%= cat %></option>
        <% end %>
      </select>
    </div>
    <div class="flex-1 min-w-0">
      <label for="post_title" class="block text-sm font-medium text-gray-700 mb-1">제목</label>
      <input type="text" name="post[title]" id="post_title" value="<%= post.title %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 text-base" style="focus:ring-color: #D4A373; focus:border-color: #D4A373;">
    </div>
    <%# 수정 버튼 (자기 글인 경우에만 표시, edit 페이지에서만) - 빠른 수정용 주황색 버튼 %>
    <% if post.persisted? && user_signed_in? && post.user == current_user %>
      <div class="w-[10%] min-w-[100px] flex flex-col justify-end">
        <button type="submit" form="post-form" class="px-2 py-1.5 text-xs rounded transition text-center flex-1" style="background-color: #FF8C00; color: white; border: none; cursor: pointer; font-weight: 500; min-height: 44px;" onmouseover="this.style.backgroundColor='#FF7700';" onmouseout="this.style.backgroundColor='#FF8C00';" onclick="document.getElementById('submit_button').textContent='처리 중...'; document.getElementById('submit_button').disabled=true;">
          수정
        </button>
      </div>
    <% end %>
  </div>

  <div>
    <label for="post_content" class="block text-sm font-medium text-gray-700 mb-1">내용</label>
    <textarea name="post[content]" id="post_content" rows="12" class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 text-base resize-y font-mono text-sm" style="focus:ring-color: #D4A373; focus:border-color: #D4A373;" placeholder="텍스트를 입력하세요.&#10;이미지를 삽입하려면:&#10;&lt;img src=&quot;https://your-app.fly.dev/rails/active_storage/blobs/redirect/.../image.jpg&quot;&gt;"><%= post.content %></textarea>
    <p class="text-xs text-gray-500 mt-1">
      이미지를 삽입하려면 <code class="bg-gray-100 px-1 rounded">&lt;img src="이미지-URL"&gt;</code> 태그를 사용하세요. 
      이미지 URL은 <a href="/admin/uploads" target="_blank" class="text-blue-600 hover:underline">관리자 페이지</a>에서 복사할 수 있습니다.
    </p>
  </div>

  <div>
    <label for="post_attachment_file" class="block text-sm font-medium text-gray-700 mb-1">첨부파일</label>
    <% if post.attachment_file.attached? %>
      <div class="mb-2 p-2 bg-gray-50 rounded border border-gray-200">
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-600">
            <svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            현재 첨부파일: <%= post.attachment_file.filename %>
          </span>
          <%= link_to "다운로드", rails_blob_path(post.attachment_file, only_path: true), class: "text-xs text-blue-600 hover:underline", target: "_blank" %>
        </div>
      </div>
    <% end %>
    <input type="file" name="post[attachment_file]" id="post_attachment_file" accept="image/*,.pdf" class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 text-base file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:cursor-pointer" style="focus:ring-color: #D4A373; focus:border-color: #D4A373; file:background-color: #D4A373; file:text-white;">
    <p class="text-xs text-gray-500 mt-1">이미지 파일(jpg, png, gif, webp) 또는 PDF 파일을 업로드할 수 있습니다. (최대 10MB, 새 파일을 선택하면 기존 파일이 교체됩니다)</p>
    <% if post.errors[:attachment_file].any? %>
      <p class="text-xs text-red-500 mt-1"><%= post.errors[:attachment_file].first %></p>
    <% end %>
  </div>

  <div class="pt-4">
    <button type="submit" id="submit_button" class="w-full py-3 bg-slate-700 text-white font-bold rounded-lg cursor-pointer text-base" style="background-color: #475569; color: white; width: 100%; padding: 0.75rem; border-radius: 0.5rem; font-weight: 700; font-size: 1rem; border: none; cursor: pointer; min-height: 44px;">
      <%= post.persisted? ? "수정" : "저장하기" %>
    </button>
  </div>
</form>