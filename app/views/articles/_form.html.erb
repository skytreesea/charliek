<%= form_with(model: article, class: "space-y-6") do |form| %>
  <% if article.errors.any? %>
    <div class="p-4 bg-red-100 text-red-700 rounded-lg">
      <h2 class="font-bold mb-2"><%= pluralize(article.errors.count, "개의 오류") %>가 있습니다:</h2>
      <ul class="list-disc list-inside">
        <% article.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "제목", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_field :title, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition", placeholder: "기사 제목을 입력하세요" %>
  </div>

  <div>
    <%= form.label :keywords, "키워드", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_field :keywords, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition", placeholder: "쉼표로 구분하여 키워드 입력 (예: AI, 뉴스, 기술)" %>
    <p class="mt-1 text-sm text-gray-500">쉼표로 구분하여 여러 키워드를 입력할 수 있습니다.</p>
  </div>

  <div>
    <%= form.label :content, "내용", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_area :content, rows: 15, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition", placeholder: "기사 내용을 입력하세요..." %>
  </div>

  <div>
    <%= form.label :prompt_used, "사용된 프롬프트", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_area :prompt_used, rows: 5, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition", placeholder: "AI 기사 생성에 사용된 프롬프트를 기록하세요 (선택사항)" %>
    <p class="mt-1 text-sm text-gray-500">AI로 생성한 경우, 사용된 프롬프트를 기록해두면 나중에 참고할 수 있습니다.</p>
  </div>

  <div class="flex gap-4">
    <%= form.submit article.persisted? ? "수정하기" : "기사 생성", class: "px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition cursor-pointer" %>
  </div>
<% end %>
